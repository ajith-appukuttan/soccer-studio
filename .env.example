# Environment Configuration

# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000/api

# Database
DATABASE_URL=postgresql://postgres:password123@localhost:5432/soccerstudio

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false

# File Upload
MAX_FILE_SIZE=5368709120  # 5GB in bytes
UPLOAD_PATH=./uploads
ALLOWED_VIDEO_TYPES=mp4,mov,avi,mkv,webm

# Video Processing
FFMPEG_PATH=/usr/bin/ffmpeg
VIDEO_PROCESSING_CONCURRENCY=2

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Security
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# External APIs
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_API_URL=https://api.anthropic.com

# Development
HOT_RELOAD=true
DEBUG=false

# Production overrides (set these in production)
# NODE_ENV=production
# DATABASE_URL=postgresql://user:password@prod-db:5432/soccerstudio
# REDIS_URL=redis://prod-redis:6379
# FRONTEND_URL=https://soccerstudio.com
# VITE_API_URL=https://api.soccerstudio.com
# JWT_SECRET=very-secure-secret-key-for-production