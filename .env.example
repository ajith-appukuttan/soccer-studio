# Environment Configuration for Soccer Studio
# This is a client-side application that stores data in IndexedDB
# No backend services are required

# Development
NODE_ENV=development
DEBUG=false

# Note: Soccer Studio is a client-side application
# All video processing and storage happens in the browser using:
# - IndexedDB for project data storage
# - Web APIs for video processing
# - Canvas API for annotations
# - MediaRecorder API for voice commentary